# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# Virtual environments
.venv/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Project-specific
# Contains sensitive Fantrax cookies — NOTE: git does not support inline
# comments in .gitignore, so this must be on its own line above the pattern.
config.json
# Derived data artifacts (regenerable by data_prep). Patterns must be
# recursive: an earlier `data_prep/data/*.csv` matched only the top level, so
# every pulled_YYYYMMDD/ projection CSV stayed tracked (~110 MB).
data/**/*.db
data/**/*.json
data/**/*.csv
data/**/*.parquet
data_prep/data/**/*.db
data_prep/data/**/*.parquet
data_prep/data/**/*.csv
!data/.gitkeep
!data_prep/data/.gitkeep

# Marimo session files
__marimo__/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Temporary/debug scripts
explore_*.py
debug_*.py
test_*.py
!tests/test_*.py

# Local agent/tooling runtime state
.atl/
.pi/
node_modules/
package.json
package-lock.json
